<%
  title = title || "Add Property";
  page  = page  || "properties";
%>

<style>
  .ap-wrap{display:grid;grid-template-columns:1fr 340px;gap:20px;align-items:start;}
  .ap-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;}
  .ap-title{font-size:22px;font-weight:700;color:#083068;}
  .ap-subtitle{font-size:13px;color:#6BAED6;margin-top:2px;}
  .ap-card{background:#fff;border:1px solid #DEEBF7;border-radius:14px;padding:22px 24px;margin-bottom:16px;}
  .ap-card-title{font-size:13px;font-weight:700;color:#083068;margin-bottom:16px;padding-bottom:10px;border-bottom:1px solid #F0F6FF;letter-spacing:.3px;}
  .ap-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  .ap-grid-1{display:grid;grid-template-columns:1fr;gap:14px;}
  .ap-fg{display:flex;flex-direction:column;gap:5px;}
  .ap-fg.full{grid-column:1/-1;}
  .ap-label{font-size:11px;font-weight:700;letter-spacing:.7px;text-transform:uppercase;color:#4a6380;}
  .ap-label span{color:#ef4444;margin-left:2px;}
  .ap-input,.ap-select,.ap-textarea{
    padding:9px 12px;border:1.5px solid #DEEBF7;border-radius:8px;
    font-size:13px;color:#083068;background:#F0F6FF;
    outline:none;font-family:inherit;width:100%;
  }
  .ap-input:focus,.ap-select:focus,.ap-textarea:focus{border-color:#6BAED6;background:#fff;box-shadow:0 0 0 3px rgba(107,174,214,.1);}
  .ap-textarea{resize:vertical;min-height:100px;}
  .ap-select{cursor:pointer;}
  .ap-toggle-row{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid #F0F6FF;}
  .ap-toggle-row:last-child{border-bottom:none;}
  .ap-toggle-label{font-size:13px;font-weight:600;color:#083068;}
  .ap-toggle-desc{font-size:11px;color:#6BAED6;margin-top:1px;}
  .ap-switch{position:relative;width:44px;height:24px;flex-shrink:0;}
  .ap-switch input{opacity:0;width:0;height:0;}
  .ap-slider{position:absolute;inset:0;background:#DEEBF7;border-radius:24px;cursor:pointer;transition:.2s;}
  .ap-slider:before{content:'';position:absolute;width:18px;height:18px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s;}
  .ap-switch input:checked + .ap-slider{background:#083068;}
  .ap-switch input:checked + .ap-slider:before{transform:translateX(20px);}
  .ap-img-drop{border:2px dashed #DEEBF7;border-radius:12px;padding:36px 20px;text-align:center;cursor:pointer;transition:.15s;background:#F8FBFF;}
  .ap-img-drop:hover{border-color:#6BAED6;background:#EEF6FF;}
  .ap-img-icon{font-size:32px;margin-bottom:8px;}
  .ap-img-text{font-size:13px;color:#083068;font-weight:600;}
  .ap-img-sub{font-size:11px;color:#6BAED6;margin-top:3px;}
  .ap-img-preview{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px;}
  .ap-img-thumb{width:70px;height:70px;border-radius:8px;object-fit:cover;border:1.5px solid #DEEBF7;}
  .ap-btn-publish{width:100%;padding:12px;background:#083068;color:#fff;border:none;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;font-family:inherit;transition:.15s;}
  .ap-btn-publish:hover{background:#08519C;}
  .ap-btn-draft{width:100%;padding:10px;background:#fff;color:#083068;border:1.5px solid #DEEBF7;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;margin-top:8px;transition:.15s;}
  .ap-btn-draft:hover{background:#F0F6FF;}
  .ap-btn-cancel{padding:8px 18px;background:#fff;color:#083068;border:1.5px solid #DEEBF7;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;}
  .ap-btn-cancel:hover{background:#F0F6FF;}
  .ap-header-actions{display:flex;align-items:center;gap:10px;}
  .ap-error{background:#FEE2E2;color:#DC2626;border:1px solid #FECACA;border-radius:8px;padding:10px 14px;font-size:13px;margin-bottom:16px;}
</style>

<!-- HEADER -->
<div class="ap-header">
  <div>
    <div class="ap-title"><%= property ? 'Edit Property' : 'Add New Property' %></div>
    <div class="ap-subtitle"><%= property ? 'Update property listing details' : 'Create a new property listing on Lanka Property' %></div>
  </div>
  <div class="ap-header-actions">
    <a href="/admin/properties"><button class="ap-btn-cancel" type="button">Cancel</button></a>
    <button class="ap-btn-publish" form="prop-form" type="submit" style="width:auto;padding:9px 22px;font-size:13px;">
      <%= property ? 'Save Changes' : 'Publish Listing' %>
    </button>
  </div>
</div>

<% if(typeof error !== 'undefined' && error) { %>
  <div class="ap-error">&#9888; <%= error %></div>
<% } %>

<form id="prop-form" method="POST"
  action="/admin/properties/<%= property ? property.id+'/edit' : 'add' %>"
  enctype="multipart/form-data">
<div class="ap-wrap">

  <!-- LEFT COLUMN -->
  <div>

    <!-- Basic Information -->
    <div class="ap-card">
      <div class="ap-card-title">Basic Information</div>
      <div class="ap-grid">
        <div class="ap-fg full">
          <label class="ap-label">Property Title <span>*</span></label>
          <input class="ap-input" type="text" name="title"
            placeholder="e.g. 3BR House — Colombo 7" required
            value="<%= property ? property.title : '' %>"/>
        </div>
        <div class="ap-fg">
          <label class="ap-label">Property Type <span>*</span></label>
          <select class="ap-select" name="type" required>
            <option value="">Select Type</option>
            <% var types = ['House','Apartment','Villa','Bungalow','Commercial','Studio','Land','Annexe','Room','Warehouse']; %>
            <% for(var ti = 0; ti < types.length; ti++) { %>
              <option value="<%= types[ti] %>" <% if(property && property.type===types[ti]){ %>selected<% } %>>
                <%= types[ti] %>
              </option>
            <% } %>
          </select>
        </div>
        <div class="ap-fg">
          <label class="ap-label">Listing Type <span>*</span></label>
          <select class="ap-select" name="listing_type" required>
            <option value="">Select</option>
            <option value="sale"  <% if(property && property.listing_type==='sale'){ %>selected<% } %>>For Sale</option>
            <option value="rent"  <% if(property && property.listing_type==='rent'){ %>selected<% } %>>For Rent</option>
            <option value="land"  <% if(property && property.listing_type==='land'){ %>selected<% } %>>Land</option>
          </select>
        </div>
        <div class="ap-fg">
          <label class="ap-label">Price (LKR) <span>*</span></label>
          <input class="ap-input" type="number" name="price" placeholder="e.g. 45000000"
            value="<%= property ? property.price : '' %>"/>
        </div>
        <div class="ap-fg">
          <label class="ap-label">Price Type</label>
          <select class="ap-select" name="price_type">
            <option value="total"     <% if(property && property.price_type==='total'){ %>selected<% } %>>Total Price</option>
            <option value="per_month" <% if(property && property.price_type==='per_month'){ %>selected<% } %>>Per Month</option>
            <option value="per_perch" <% if(property && property.price_type==='per_perch'){ %>selected<% } %>>Per Perch</option>
            <option value="per_sqft"  <% if(property && property.price_type==='per_sqft'){ %>selected<% } %>>Per Sqft</option>
          </select>
        </div>
        <div class="ap-fg full">
          <label class="ap-label">Description</label>
          <textarea class="ap-textarea" name="description"
            placeholder="Describe the property, features, nearby amenities"><%= property ? property.description : '' %></textarea>
        </div>
      </div>
    </div>

    <!-- Location Details -->
    <div class="ap-card">
      <div class="ap-card-title">Location Details</div>
      <div class="ap-grid">
        <div class="ap-fg">
          <label class="ap-label">District <span>*</span></label>
          <select class="ap-select" name="district_id" required>
            <option value="">Select District</option>
            <% if(districts && districts.length > 0) { %>
              <% for(var di = 0; di < districts.length; di++) { %>
                <option value="<%= districts[di].id %>"
                  <% if(property && property.district_id==districts[di].id){ %>selected<% } %>>
                  <%= districts[di].name %>
                </option>
              <% } %>
            <% } %>
          </select>
        </div>
        <div class="ap-fg">
          <label class="ap-label">City / Town <span>*</span></label>
          <input class="ap-input" type="text" name="city" placeholder="e.g. Rajagiriya"
            value="<%= property ? property.city : '' %>"/>
        </div>
        <div class="ap-fg full">
          <label class="ap-label">Full Address</label>
          <input class="ap-input" type="text" name="address" placeholder="Street address"
            value="<%= property ? property.address : '' %>"/>
        </div>
      </div>
    </div>

    <!-- Property Details -->
    <div class="ap-card">
      <div class="ap-card-title">Property Details</div>
      <div class="ap-grid">
        <div class="ap-fg">
          <label class="ap-label">Bedrooms</label>
          <select class="ap-select" name="bedrooms">
            <% var beds = ['Studio',1,2,3,4,5,6,'7+']; %>
            <% for(var bi = 0; bi < beds.length; bi++) { %>
              <option value="<%= beds[bi] %>"
                <% if(property && property.bedrooms==beds[bi]){ %>selected<% } %>>
                <%= beds[bi] %>
              </option>
            <% } %>
          </select>
        </div>
        <div class="ap-fg">
          <label class="ap-label">Bathrooms</label>
          <select class="ap-select" name="bathrooms">
            <% var baths = [1,2,3,4,5,6,'7+']; %>
            <% for(var bai = 0; bai < baths.length; bai++) { %>
              <option value="<%= baths[bai] %>"
                <% if(property && property.bathrooms==baths[bai]){ %>selected<% } %>>
                <%= baths[bai] %>
              </option>
            <% } %>
          </select>
        </div>
        <div class="ap-fg">
          <label class="ap-label">Land Size (perches)</label>
          <input class="ap-input" type="number" step="0.1" name="land_area" placeholder="e.g. 12"
            value="<%= property ? property.land_area : '' %>"/>
        </div>
        <div class="ap-fg">
          <label class="ap-label">Floor Area (sqft)</label>
          <input class="ap-input" type="number" name="floor_area" placeholder="e.g. 2400"
            value="<%= property ? property.floor_area : '' %>"/>
        </div>
      </div>
    </div>

    <!-- Agent Info -->
    <div class="ap-card">
      <div class="ap-card-title">Agent Information</div>
      <div class="ap-grid">
        <div class="ap-fg">
          <label class="ap-label">Agent Name</label>
          <input class="ap-input" type="text" name="agent_name" placeholder="Agent full name"
            value="<%= property ? property.agent_name : '' %>"/>
        </div>
        <div class="ap-fg">
          <label class="ap-label">Agent Phone</label>
          <input class="ap-input" type="text" name="agent_phone" placeholder="+94 77 123 4567"
            value="<%= property ? property.agent_phone : '' %>"/>
        </div>
      </div>
    </div>

  </div><!-- /left -->

  <!-- RIGHT COLUMN -->
  <div>

    <!-- Property Images -->
    <div class="ap-card">
      <div class="ap-card-title">Property Images</div>
      <div class="ap-img-drop" onclick="document.getElementById('img-upload').click()">
        <div class="ap-img-icon">&#128247;</div>
        <div class="ap-img-text">Click to upload or drag & drop</div>
        <div class="ap-img-sub">PNG, JPG up to 10MB each &middot; Max 20 images</div>
        <input id="img-upload" type="file" name="images" multiple accept="image/*"
          style="display:none;" onchange="previewImages(this)"/>
      </div>
      <div class="ap-img-preview" id="img-preview"></div>
    </div>

    <!-- Listing Settings -->
    <div class="ap-card">
      <div class="ap-card-title">Listing Settings</div>

      <div class="ap-fg" style="margin-bottom:14px;">
        <label class="ap-label">Assign Agent</label>
        <select class="ap-select" name="assigned_agent_id">
          <option value="">Select Agent</option>
          <% if(typeof agents !== 'undefined' && agents && agents.length > 0) { %>
            <% for(var ai = 0; ai < agents.length; ai++) { %>
              <option value="<%= agents[ai].id %>"><%= agents[ai].name %></option>
            <% } %>
          <% } %>
        </select>
      </div>

      <div class="ap-fg" style="margin-bottom:16px;">
        <label class="ap-label">Listing Status</label>
        <select class="ap-select" name="status">
          <option value="active"  <% if(!property || property.status==='active'){ %>selected<% } %>>Active</option>
          <option value="pending" <% if(property && property.status==='pending'){ %>selected<% } %>>Pending</option>
          <option value="sold"    <% if(property && property.status==='sold'){ %>selected<% } %>>Sold</option>
          <option value="rented"  <% if(property && property.status==='rented'){ %>selected<% } %>>Rented</option>
          <option value="expired" <% if(property && property.status==='expired'){ %>selected<% } %>>Expired</option>
        </select>
      </div>

      <div class="ap-toggle-row">
        <div class="ap-toggle-info">
          <div class="ap-toggle-label">Feature this listing</div>
          <div class="ap-toggle-desc">Shows on homepage and top results</div>
        </div>
        <label class="ap-switch">
          <input type="checkbox" name="is_featured" value="1"
            <% if(property && property.is_featured){ %>checked<% } %>>
          <span class="ap-slider"></span>
        </label>
      </div>

      <div class="ap-toggle-row">
        <div class="ap-toggle-info">
          <div class="ap-toggle-label">Allow inquiries</div>
          <div class="ap-toggle-desc">Users can contact you about this</div>
        </div>
        <label class="ap-switch">
          <input type="checkbox" name="allow_inquiries" value="1"
            <% if(!property || property.allow_inquiries !== 0){ %>checked<% } %>>
          <span class="ap-slider"></span>
        </label>
      </div>

    </div>

    <!-- Publish Buttons -->
    <button class="ap-btn-publish" type="submit">
      <%= property ? 'Save Changes' : 'Publish Listing' %>
    </button>
    <button class="ap-btn-draft" type="submit" name="status" value="pending">
      Save as Draft
    </button>

  </div><!-- /right -->

</div>
</form>

<script>
function previewImages(input) {
  var preview = document.getElementById('img-preview');
  preview.innerHTML = '';
  Array.from(input.files).forEach(function(file) {
    var reader = new FileReader();
    reader.onload = function(e) {
      var img = document.createElement('img');
      img.src = e.target.result;
      img.className = 'ap-img-thumb';
      preview.appendChild(img);
    };
    reader.readAsDataURL(file);
  });
}
</script>
