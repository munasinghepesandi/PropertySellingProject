<%
  title = "Settings";
  page  = "settings";
%>

<style>
  .settings-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 20px;
  }
  .settings-header h1 {
    font-size: 18px;
    font-weight: 700;
    color: #083068;
    margin: 0 0 3px;
  }
  .settings-header p {
    font-size: 12px;
    color: #6BAED6;
    margin: 0;
  }
  .btn-save {
    background: #2171B5;
    color: #fff;
    border: none;
    padding: 9px 20px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    letter-spacing: 0.3px;
  }
  .btn-save:hover { background: #1a5c96; }

  /* Success banner */
  .alert-success {
    background: #dcfce7;
    border: 1px solid #86efac;
    border-radius: 8px;
    padding: 11px 16px;
    margin-bottom: 18px;
    color: #166534;
    font-size: 13px;
  }

  /* Two-column layout */
  .settings-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  /* Section cards */
  .s-card {
    background: #fff;
    border: 1px solid #DEEBF7;
    border-radius: 12px;
    padding: 20px;
  }
  .s-card-title {
    font-size: 13px;
    font-weight: 700;
    color: #083068;
    margin-bottom: 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid #DEEBF7;
  }

  /* Form fields */
  .f-group { margin-bottom: 14px; }
  .f-label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    color: #08519C;
    text-transform: uppercase;
    letter-spacing: 0.7px;
    margin-bottom: 5px;
  }
  .f-input, .f-select {
    width: 100%;
    padding: 9px 12px;
    border: 1px solid #DEEBF7;
    border-radius: 8px;
    font-size: 13px;
    color: #083068;
    background: #fff;
    outline: none;
    font-family: inherit;
    transition: border-color .15s, box-shadow .15s;
  }
  .f-input:focus, .f-select:focus {
    border-color: #2171B5;
    box-shadow: 0 0 0 3px rgba(33,113,181,.1);
  }
  .f-input::placeholder { color: #9ECAE1; }

  /* Divider inside card */
  .f-divider {
    border: none;
    border-top: 1px solid #DEEBF7;
    margin: 16px 0;
  }
  .f-section-label {
    font-size: 11px;
    font-weight: 700;
    color: #08519C;
    text-transform: uppercase;
    letter-spacing: 0.7px;
    margin-bottom: 12px;
  }

  /* Toggle switch */
  .toggle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid #F0F6FC;
  }
  .toggle-row:last-child { border-bottom: none; }
  .toggle-label {
    font-size: 13px;
    color: #083068;
    font-weight: 500;
  }
  .toggle-sub {
    font-size: 11px;
    color: #6BAED6;
    margin-top: 1px;
  }
  .toggle {
    position: relative;
    width: 38px;
    height: 22px;
    flex-shrink: 0;
  }
  .toggle input { opacity: 0; width: 0; height: 0; }
  .toggle-slider {
    position: absolute;
    inset: 0;
    background: #DEEBF7;
    border-radius: 22px;
    cursor: pointer;
    transition: background .2s;
  }
  .toggle-slider::before {
    content: '';
    position: absolute;
    width: 16px; height: 16px;
    left: 3px; top: 3px;
    background: #fff;
    border-radius: 50%;
    transition: transform .2s;
    box-shadow: 0 1px 3px rgba(0,0,0,.2);
  }
  .toggle input:checked + .toggle-slider { background: #2171B5; }
  .toggle input:checked + .toggle-slider::before { transform: translateX(16px); }

  /* Listing defaults grid */
  .f-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

  /* Password hint */
  .f-hint {
    font-size: 11px;
    color: #9ECAE1;
    margin-top: 4px;
  }
</style>

<div class="settings-header">
  <div>
    <h1>Settings</h1>
    <p>System and account configuration</p>
  </div>
  <button class="btn-save" onclick="saveAll()">Save Changes</button>
</div>

<% if(locals.success) { %>
  <div class="alert-success">✓ Settings saved successfully.</div>
<% } %>

<div class="settings-grid">

  <!-- LEFT COLUMN -->
  <div style="display:flex;flex-direction:column;gap:18px;">

    <!-- Site Settings -->
    <div class="s-card">
      <div class="s-card-title">Site Settings</div>
      <form id="form-general" method="POST" action="/admin/settings/general">
        <div class="f-group">
          <label class="f-label">Site Name</label>
          <input class="f-input" type="text" name="siteName"
            value="<%= settings.siteName || 'Lanka Property' %>"/>
        </div>
        <div class="f-group">
          <label class="f-label">Contact Email</label>
          <input class="f-input" type="email" name="contactEmail"
            value="<%= settings.contactEmail || '' %>"
            placeholder="admin@lankaproperty.lk"/>
        </div>
        <div class="f-group">
          <label class="f-label">Contact Phone</label>
          <input class="f-input" type="text" name="contactPhone"
            value="<%= settings.contactPhone || '' %>"
            placeholder="+94 11 234 5678"/>
        </div>
        <div class="f-group" style="margin-bottom:0;">
          <label class="f-label">Default Currency</label>
          <select class="f-select" name="currency">
            <option value="LKR" <%= (settings.currency||'LKR')==='LKR'?'selected':'' %>>
              LKR — Sri Lankan Rupee
            </option>
            <option value="USD" <%= settings.currency==='USD'?'selected':'' %>>
              USD — US Dollar
            </option>
          </select>
        </div>
      </form>
    </div>

    <!-- Listing Defaults -->
    <div class="s-card">
      <div class="s-card-title">Listing Defaults</div>
      <form id="form-listings" method="POST" action="/admin/settings/listings">
        <div class="f-group">
          <label class="f-label">Default Listing Duration (days)</label>
          <input class="f-input" type="number" name="featuredDays"
            min="1" max="365" value="<%= settings.featuredDays || 30 %>"/>
        </div>
        <div class="f-group" style="margin-bottom:0;">
          <label class="f-label">Require Admin Approval</label>
          <select class="f-select" name="defaultStatus">
            <option value="pending"
              <%= (settings.defaultStatus||'pending')==='pending'?'selected':'' %>>
              Yes — Manual Approval
            </option>
            <option value="active"
              <%= settings.defaultStatus==='active'?'selected':'' %>>
              No — Auto Approve
            </option>
          </select>
        </div>
      </form>
    </div>

  </div>

  <!-- RIGHT COLUMN -->
  <div style="display:flex;flex-direction:column;gap:18px;">

    <!-- Admin Profile -->
    <div class="s-card">
      <div class="s-card-title">Admin Profile</div>
      <form id="form-account" method="POST" action="/admin/settings/account">
        <div class="f-group">
          <label class="f-label">Full Name</label>
          <input class="f-input" type="text" name="displayName"
            value="<%= admin.name || 'Admin User' %>"/>
        </div>
        <div class="f-group">
          <label class="f-label">Email</label>
          <input class="f-input" type="email" name="email"
            value="<%= admin.email || '' %>"/>
        </div>
        <div class="f-group" style="margin-bottom:0;">
          <label class="f-label">New Password</label>
          <input class="f-input" type="password" name="newPassword"
            placeholder="Leave blank to keep current"/>
          <div class="f-hint">Leave blank to keep your current password</div>
        </div>
      </form>
    </div>

    <!-- Notifications -->
    <div class="s-card">
      <div class="s-card-title">Notifications</div>
      <form id="form-notifications" method="POST" action="/admin/settings/notifications">
        <div class="toggle-row">
          <div>
            <div class="toggle-label">New inquiry alerts</div>
            <div class="toggle-sub">Get notified on new property inquiries</div>
          </div>
          <label class="toggle">
            <input type="checkbox" name="notifyNewInquiry" value="1"
              <%= settings.notifyNewInquiry ? 'checked' : '' %>/>
            <span class="toggle-slider"></span>
          </label>
        </div>
        <div class="toggle-row">
          <div>
            <div class="toggle-label">New user registrations</div>
            <div class="toggle-sub">Alert when a new user signs up</div>
          </div>
          <label class="toggle">
            <input type="checkbox" name="notifyNewUser" value="1"
              <%= settings.notifyNewUser ? 'checked' : '' %>/>
            <span class="toggle-slider"></span>
          </label>
        </div>
        <div class="toggle-row">
          <div>
            <div class="toggle-label">Weekly summary report</div>
            <div class="toggle-sub">Receive weekly analytics digest</div>
          </div>
          <label class="toggle">
            <input type="checkbox" name="notifyWeekly" value="1"
              <%= settings.notifyWeekly ? 'checked' : '' %>/>
            <span class="toggle-slider"></span>
          </label>
        </div>
      </form>
    </div>

  </div>
</div>

<script>
  function saveAll() {
    // Submit all forms sequentially
    const forms = ['form-general', 'form-listings', 'form-account', 'form-notifications'];
    // Submit only the first form; for full multi-form save you'd use fetch/AJAX
    // For simplicity, submit general form (which reloads page with ?success=1)
    document.getElementById('form-general').submit();
  }
</script>
