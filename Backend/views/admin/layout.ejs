<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title ? `${title} | Lanka Property` : 'Lanka Property' %></title>
    <style>
      :root {
        color-scheme: light;
        --bg: #f6f7fb;
        --panel: #ffffff;
        --text: #1f2937;
        --muted: #6b7280;
        --brand: #0f766e;
        --brand-soft: #ccfbf1;
        --border: #e5e7eb;
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: linear-gradient(180deg, #eef2ff 0%, var(--bg) 100%);
        color: var(--text);
      }

      .shell {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 260px 1fr;
      }

      .sidebar {
        background: #0f172a;
        color: #fff;
        padding: 28px 20px;
      }

      .brand {
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 28px;
      }

      .nav a {
        display: block;
        color: #cbd5e1;
        text-decoration: none;
        padding: 12px 14px;
        border-radius: 12px;
        margin-bottom: 8px;
      }

      .nav a:hover {
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
      }

      .content {
        padding: 32px;
      }

      .page-card {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 12px 32px rgba(15, 23, 42, 0.08);
      }

      .page-title {
        margin: 0 0 8px;
        font-size: 30px;
      }

      .page-subtitle {
        margin: 0 0 24px;
        color: var(--muted);
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
      }

      .stat {
        background: linear-gradient(180deg, #fff, #f8fafc);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 20px;
      }

      .stat-label {
        font-size: 14px;
        color: var(--muted);
        margin-bottom: 10px;
      }

      .stat-value {
        font-size: 34px;
        font-weight: 700;
        color: var(--brand);
      }

      @media (max-width: 900px) {
        .shell { grid-template-columns: 1fr; }
        .sidebar { padding-bottom: 8px; }
        .grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar">
        <div class="brand">Lanka Property</div>
        <nav class="nav">
          <a href="/admin/dashboard">Dashboard</a>
          <a href="/api/properties">Properties API</a>
          <a href="/api/auth/types">User Types API</a>
        </nav>
      </aside>
      <main class="content">
        <%- body %>
      </main>
    </div>
  </body>
</html>