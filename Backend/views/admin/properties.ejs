<%
  title = title || "Properties";
  page  = page  || "properties";
%>

<style>
  .prop-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 20px;
  }
  .prop-title { font-size: 22px; font-weight: 700; color: #083068; }

  .prop-filter-card {
    background: #fff; border: 1px solid #DEEBF7; border-radius: 14px;
    padding: 16px 20px; margin-bottom: 16px;
  }
  .prop-filter-row {
    display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap;
  }
  .prop-filter-group { display: flex; flex-direction: column; gap: 5px; }
  .prop-filter-group label {
    font-size: 11px; font-weight: 600; letter-spacing: .6px;
    text-transform: uppercase; color: #4a6380;
  }
  .prop-input {
    padding: 8px 12px; border: 1.5px solid #DEEBF7; border-radius: 8px;
    font-size: 13px; color: #083068; background: #F0F6FF;
    outline: none; font-family: inherit; transition: border-color .15s;
  }
  .prop-input:focus { border-color: #6BAED6; background: #fff; }
  .prop-input-wide { width: 200px; }
  .prop-input-mid  { width: 140px; }
  .prop-input-sm   { width: 120px; }

  .prop-btn {
    padding: 9px 20px; border-radius: 8px; font-size: 13px;
    font-weight: 600; cursor: pointer; border: none;
    text-decoration: none; display: inline-flex;
    align-items: center; gap: 6px; font-family: inherit;
  }
  .prop-btn-primary { background: #083068; color: #fff; }
  .prop-btn-primary:hover { background: #08519C; }
  .prop-btn-outline {
    background: #fff; color: #083068; border: 1.5px solid #DEEBF7;
  }
  .prop-btn-outline:hover { background: #F0F6FF; }
  .prop-btn-sm { padding: 6px 14px; font-size: 12px; }
  .prop-btn-danger {
    background: #FEE2E2; color: #DC2626; border: 1.5px solid #FCA5A5;
  }
  .prop-btn-danger:hover { background: #FCA5A5; }

  .prop-table-card {
    background: #fff; border: 1px solid #DEEBF7;
    border-radius: 14px; overflow: hidden;
  }
  .prop-table { width: 100%; border-collapse: collapse; }
  .prop-table thead tr { background: #F0F6FF; border-bottom: 2px solid #DEEBF7; }
  .prop-table th {
    padding: 12px 14px; text-align: left;
    font-size: 11px; font-weight: 700;
    letter-spacing: .8px; text-transform: uppercase; color: #4a6380;
  }
  .prop-table tbody tr {
    border-bottom: 1px solid #F0F6FF; transition: background .12s;
  }
  .prop-table tbody tr:last-child { border-bottom: none; }
  .prop-table tbody tr:hover { background: #F8FBFF; }
  .prop-table td {
    padding: 11px 14px; font-size: 13px; color: #083068; vertical-align: middle;
  }
  .prop-num   { color: #6BAED6; font-weight: 600; font-size: 12px; }
  .prop-name  { font-weight: 600; color: #083068; font-size: 13px; }
  .prop-addr  { font-size: 11px; color: #6BAED6; margin-top: 2px; }
  .prop-price { font-weight: 700; color: #2171B5; }
  .prop-date  { font-size: 11.5px; color: #6BAED6; }

  .ptag {
    display: inline-block; padding: 3px 10px; border-radius: 20px;
    font-size: 11px; font-weight: 600; letter-spacing: .3px;
  }
  .ptag-type     { background: #DEEBF7; color: #08519C; }
  .ptag-sale     { background: #D1FAE5; color: #065F46; }
  .ptag-rent     { background: #DBEAFE; color: #1D4ED8; }
  .ptag-land     { background: #FEF3C7; color: #92400E; }
  .ptag-active   { background: #D1FAE5; color: #065F46; }
  .ptag-pending  { background: #FEF3C7; color: #92400E; }
  .ptag-inactive { background: #F3F4F6; color: #6B7280; }
  .ptag-sold     { background: #EDE9FE; color: #5B21B6; }
  .ptag-rented   { background: #DBEAFE; color: #1D4ED8; }
  .ptag-rejected { background: #FEE2E2; color: #DC2626; }
  .ptag-expired  { background: #F3F4F6; color: #6B7280; }

  .prop-actions { display: flex; gap: 6px; align-items: center; }

  .prop-pagination {
    display: flex; gap: 6px; justify-content: center; padding: 16px 0 4px;
  }
  .prop-page-btn {
    width: 34px; height: 34px; border-radius: 8px;
    border: 1.5px solid #DEEBF7; background: #fff;
    color: #083068; font-size: 13px; font-weight: 600;
    cursor: pointer; transition: all .15s;
  }
  .prop-page-btn:hover { background: #F0F6FF; }
  .prop-page-btn.active { background: #083068; color: #fff; border-color: #083068; }

  .prop-empty {
    text-align: center; padding: 48px 20px; color: #6BAED6; font-size: 14px;
  }
  .prop-empty-icon { font-size: 40px; margin-bottom: 10px; }
</style>

<!-- PAGE HEADER -->
<div class="prop-header">
  <div class="prop-title">All Properties</div>
  <a href="/admin/properties/add" class="prop-btn prop-btn-primary">+ Add Property</a>
</div>

<!-- FILTER BAR -->
<div class="prop-filter-card">
  <form method="GET" action="/admin/properties">
    <div class="prop-filter-row">
      <div class="prop-filter-group" style="flex:1;min-width:160px;">
        <label>Search</label>
        <input class="prop-input prop-input-wide" type="text" name="q"
               placeholder="Title, location…" value="<%= filters.q || '' %>"/>
      </div>
      <div class="prop-filter-group">
        <label>Type</label>
        <select class="prop-input prop-input-mid" name="type">
          <option value="">All Types</option>
          <option value="House"      <%= filters.type==='House'      ? 'selected':'' %>>House</option>
          <option value="Apartment"  <%= filters.type==='Apartment'  ? 'selected':'' %>>Apartment</option>
          <option value="Villa"      <%= filters.type==='Villa'      ? 'selected':'' %>>Villa</option>
          <option value="Land"       <%= filters.type==='Land'       ? 'selected':'' %>>Land</option>
          <option value="Commercial" <%= filters.type==='Commercial' ? 'selected':'' %>>Commercial</option>
          <option value="Studio"     <%= filters.type==='Studio'     ? 'selected':'' %>>Studio</option>
          <option value="Bungalow"   <%= filters.type==='Bungalow'   ? 'selected':'' %>>Bungalow</option>
        </select>
      </div>
      <div class="prop-filter-group">
        <label>District</label>
        <select class="prop-input prop-input-mid" name="district">
          <option value="">All Districts</option>
          <% if(districts && districts.length > 0) { %>
            <% districts.forEach(function(d) { %>
              <option value="<%= d.id %>" <%= filters.district==d.id ? 'selected':'' %>><%= d.name %></option>
            <% }) %>
          <% } %>
        </select>
      </div>
      <div class="prop-filter-group">
        <label>Listing</label>
        <select class="prop-input prop-input-sm" name="listing_type">
          <option value="">All</option>
          <option value="sale" <%= filters.listing_type==='sale' ? 'selected':'' %>>Sale</option>
          <option value="rent" <%= filters.listing_type==='rent' ? 'selected':'' %>>Rent</option>
          <option value="land" <%= filters.listing_type==='land' ? 'selected':'' %>>Land</option>
        </select>
      </div>
      <div class="prop-filter-group">
        <label>Status</label>
        <select class="prop-input prop-input-sm" name="status">
          <option value="">All</option>
          <option value="active"   <%= filters.status==='active'   ? 'selected':'' %>>Active</option>
          <option value="pending"  <%= filters.status==='pending'  ? 'selected':'' %>>Pending</option>
          <option value="sold"     <%= filters.status==='sold'     ? 'selected':'' %>>Sold</option>
          <option value="rented"   <%= filters.status==='rented'   ? 'selected':'' %>>Rented</option>
          <option value="inactive" <%= filters.status==='inactive' ? 'selected':'' %>>Inactive</option>
        </select>
      </div>
      <div class="prop-filter-group">
        <label>&nbsp;</label>
        <button class="prop-btn prop-btn-primary" type="submit">Filter</button>
      </div>
    </div>
  </form>
</div>

<!-- TABLE -->
<div class="prop-table-card">
  <table class="prop-table">
    <thead>
      <tr>
        <th>No</th>
        <th>Property</th>
        <th>District</th>
        <th>Type</th>
        <th>Listing</th>
        <th>Price</th>
        <th>Status</th>
        <th>Added</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if(properties && properties.length > 0) { %>
        <% properties.forEach(function(p, i) { %>
        <tr>
          <td class="prop-num"><%= (currentPage-1)*perPage + i + 1 %></td>
          <td>
            <div class="prop-name"><%= p.title %></div>
            <div class="prop-addr"><%= p.address || p.city || '—' %></div>
          </td>
          <td><%= p.district || '—' %></td>
          <td><span class="ptag ptag-type"><%= p.type || '—' %></span></td>
          <td>
            <span class="ptag ptag-<%= (p.listingType||'').toLowerCase() %>">
              <%= p.listingType || '—' %>
            </span>
          </td>
          <td class="prop-price"><%= p.price %></td>
          <td>
            <span class="ptag ptag-<%= (p.status||'').toLowerCase() %>">
              <%= (p.status||'').charAt(0).toUpperCase()+(p.status||'').slice(1) %>
            </span>
          </td>
          <td class="prop-date"><%= p.createdAt %></td>
          <td>
            <div class="prop-actions">
              <a href="/admin/properties/<%= p.id %>/edit">
                <button class="prop-btn prop-btn-outline prop-btn-sm">✏️ Edit</button>
              </a>
              <form method="POST" action="/admin/properties/<%= p.id %>/delete"
                    style="display:inline;" onsubmit="return confirm('Delete this property?')">
                <button class="prop-btn prop-btn-danger prop-btn-sm" type="submit">🗑️ Del</button>
              </form>
            </div>
          </td>
        </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="9">
            <div class="prop-empty">
              <div class="prop-empty-icon">🏠</div>
              <div>No properties found.</div>
            </div>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>

  <!-- PAGINATION -->
  <% if(totalPages > 1) { %>
    <div class="prop-pagination">
      <% for(var i = 1; i <= totalPages; i++) { %>
        <a href="?page=<%= i %><%= filters.q ? '&q='+filters.q : '' %><%= filters.type ? '&type='+filters.type : '' %><%= filters.district ? '&district='+filters.district : '' %><%= filters.status ? '&status='+filters.status : '' %>">
          <button class="prop-page-btn <%= i===currentPage ? 'active' : '' %>"><%= i %></button>
        </a>
      <% } %>
    </div>
  <% } %>
</div>
