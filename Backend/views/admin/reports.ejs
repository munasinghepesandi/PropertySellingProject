<%
  title = "Reports";
  page  = "reports";
%>

<div class="page-title">Reports & Analytics</div>

<!-- Top Stats -->
<div class="stats">
  <div class="stat-card">
    <div class="stat-label">Total Revenue</div>
    <div class="stat-val">LKR <%= (report.totalRevenue || 0).toLocaleString() %></div>
    <div class="stat-change">+<%= report.revenueGrowth %>% vs last month</div>
  </div>
  <div class="stat-card c2">
    <div class="stat-label">New Listings</div>
    <div class="stat-val"><%= report.newListings %></div>
    <div class="stat-change">This month</div>
  </div>
  <div class="stat-card c3">
    <div class="stat-label">New Users</div>
    <div class="stat-val"><%= report.newUsers %></div>
    <div class="stat-change">This month</div>
  </div>
  <div class="stat-card c4">
    <div class="stat-label">Conversion Rate</div>
    <div class="stat-val"><%= report.conversionRate %>%</div>
    <div class="stat-change">Inquiry → Contact</div>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:16px;">

  <!-- Listings by District -->
  <div class="card">
    <div class="card-title">Listings by District</div>
    <div class="bar-wrap">
      <% var distColors = ['#083068','#08519C','#2171B5','#6BAED6','#C6DBEF']; %>
      <% report.byDistrict.forEach(function(d, i) { %>
      <div class="bar-row">
        <div class="bar-label"><%= d.name %></div>
        <div class="bar-bg">
          <div class="bar-fill" style="width:<%= d.pct %>%;background:<%= distColors[i % distColors.length] %>;"></div>
        </div>
        <div class="bar-val"><%= d.count %></div>
      </div>
      <% }) %>
    </div>
  </div>

  <!-- Listings by Type -->
  <div class="card">
    <div class="card-title">Listings by Type</div>
    <div class="bar-wrap">
      <% var typeColors = ['#083068','#08519C','#2171B5','#6BAED6','#C6DBEF']; %>
      <% report.byType.forEach(function(t, i) { %>
      <div class="bar-row">
        <div class="bar-label"><%= t.name %></div>
        <div class="bar-bg">
          <div class="bar-fill" style="width:<%= t.pct %>%;background:<%= typeColors[i % typeColors.length] %>;"></div>
        </div>
        <div class="bar-val"><%= t.count %></div>
      </div>
      <% }) %>
    </div>
  </div>

</div>

<!-- Monthly Inquiry Breakdown -->
<div class="card" style="margin-bottom:16px;">
  <div class="card-title">Monthly Inquiry Breakdown</div>
  <table class="tbl">
    <thead>
      <tr>
        <th>Month</th>
        <th>New Inquiries</th>
        <th>Resolved</th>
        <th>Pending</th>
        <th>Response Rate</th>
      </tr>
    </thead>
    <tbody>
    <% if(report.monthlyInquiries && report.monthlyInquiries.length > 0) { %>
      <% report.monthlyInquiries.forEach(function(m) { %>
      <tr>
        <td style="font-weight:600;color:#083068;"><%= m.month %></td>
        <td style="color:#2171B5;font-weight:600;"><%= m.total %></td>
        <td><span class="status active"><%= m.resolved %></span></td>
        <td><span class="status pending"><%= m.pending %></span></td>
        <td style="color:#08519C;"><%= m.responseRate %>%</td>
      </tr>
      <% }) %>
    <% } else { %>
      <tr>
        <td colspan="5" style="text-align:center;padding:30px;color:#6BAED6;">
          No data available
        </td>
      </tr>
    <% } %>
    </tbody>
  </table>
</div>

<!-- Export Reports -->
<div class="card">
  <div class="card-title">Export Reports</div>
  <div style="display:flex;gap:10px;flex-wrap:wrap;">
    <form method="GET" action="/admin/reports/export">
      <input type="hidden" name="type" value="properties"/>
      <button class="btn-blue" type="submit">Export Properties CSV</button>
    </form>
    <form method="GET" action="/admin/reports/export">
      <input type="hidden" name="type" value="users"/>
      <button class="btn-outline" type="submit">Export Users CSV</button>
    </form>
    <form method="GET" action="/admin/reports/export">
      <input type="hidden" name="type" value="inquiries"/>
      <button class="btn-outline" type="submit">Export Inquiries CSV</button>
    </form>
  </div>
</div>
