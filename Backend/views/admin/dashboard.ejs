<section class="page-card">
  <h1 class="page-title">Dashboard</h1>
  <p class="page-subtitle">Overview of the current property backend data.</p>

  <div class="grid">
    <div class="stat">
      <div class="stat-label">Properties</div>
      <div class="stat-value"><%= stats.propertyCount %></div>
    </div>
    <div class="stat">
      <div class="stat-label">Users</div>
      <div class="stat-value"><%= stats.userCount %></div>
    </div>
    <div class="stat">
      <div class="stat-label">User Types</div>
      <div class="stat-value"><%= stats.typeCount %></div>
    </div>
  </div>
</section>