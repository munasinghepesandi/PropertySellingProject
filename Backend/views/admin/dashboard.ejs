<%
  title = title || "Dashboard";
  page  = page  || "dashboard";
%>

<style>
  .dash-page-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 24px;
  }
  .dash-page-title { font-size: 22px; font-weight: 700; color: #083068; margin-bottom: 4px; }
  .dash-page-subtitle { font-size: 13px; color: #4a6380; }
  .dash-header-btns { display: flex; gap: 10px; }
  .dash-btn {
    padding: 9px 18px; border-radius: 8px; font-size: 13px; font-weight: 500;
    cursor: pointer; border: none; text-decoration: none;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .dash-btn-primary { background: #083068; color: #fff; }
  .dash-btn-primary:hover { background: #08519C; }
  .dash-btn-outline { background: #fff; color: #083068; border: 1.5px solid #DEEBF7; }
  .dash-btn-outline:hover { background: #F0F6FF; }

  .dash-stats {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 16px; margin-bottom: 24px;
  }
  .dash-stat {
    background: #fff; border: 1px solid #DEEBF7; border-radius: 14px;
    padding: 20px 20px 16px; position: relative; overflow: hidden;
    transition: transform .15s, box-shadow .15s;
  }
  .dash-stat:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(8,48,104,.09); }
  .dash-stat-bar {
    position: absolute; top: 0; left: 0; right: 0; height: 4px;
    border-radius: 14px 14px 0 0;
  }
  .dash-stat-label {
    font-size: 11.5px; font-weight: 600; letter-spacing: .8px;
    text-transform: uppercase; color: #4a6380; margin-bottom: 10px;
  }
  .dash-stat-val { font-size: 34px; font-weight: 800; color: #083068; line-height: 1; margin-bottom: 6px; }
  .dash-stat-sub { font-size: 12px; color: #6BAED6; }

  .dash-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
  .dash-card { background: #fff; border: 1px solid #DEEBF7; border-radius: 14px; padding: 18px 20px; }
  .dash-card-header {
    display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;
  }
  .dash-card-title { font-size: 14px; font-weight: 700; color: #083068; }

  .dash-prop-row {
    display: flex; align-items: center; gap: 12px;
    padding: 9px 0; border-bottom: 1px solid #F0F6FF;
  }
  .dash-prop-row:last-child { border-bottom: none; }
  .dash-prop-icon {
    width: 40px; height: 38px; border-radius: 8px; background: #F0F6FF;
    display: flex; align-items: center; justify-content: center;
    font-size: 19px; flex-shrink: 0;
  }
  .dash-prop-name { font-size: 13px; font-weight: 600; color: #083068; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dash-prop-meta { font-size: 11.5px; color: #4a6380; margin-top: 2px; }
  .dash-prop-price { font-size: 13px; font-weight: 700; color: #2171B5; flex-shrink: 0; }

  .dash-inq-row {
    display: flex; align-items: flex-start; gap: 12px;
    padding: 9px 0; border-bottom: 1px solid #F0F6FF;
  }
  .dash-inq-row:last-child { border-bottom: none; }
  .dash-avatar {
    width: 34px; height: 34px; border-radius: 50%;
    background: linear-gradient(135deg,#2171B5,#6BAED6);
    color: #fff; font-size: 12px; font-weight: 700;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .dash-inq-name { font-size: 13px; font-weight: 600; color: #083068; }
  .dash-inq-msg  { font-size: 11.5px; color: #4a6380; margin-top: 2px; }
  .dash-inq-time { font-size: 11px; color: #6BAED6; flex-shrink: 0; }

  .dash-bar-row { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
  .dash-bar-row:last-child { margin-bottom: 0; }
  .dash-bar-label { font-size: 12.5px; color: #083068; font-weight: 500; width: 100px; flex-shrink: 0; }
  .dash-bar-track { flex: 1; height: 10px; border-radius: 6px; background: #F0F6FF; overflow: hidden; }
  .dash-bar-fill  { height: 100%; border-radius: 6px; transition: width .4s ease; }
  .dash-bar-count { font-size: 12px; font-weight: 600; color: #2171B5; width: 36px; text-align: right; flex-shrink: 0; }
  .dash-empty { font-size: 13px; color: #6BAED6; padding: 8px 0; }
</style>

<!-- HEADER -->
<div class="dash-page-header">
  <div>
    <div class="dash-page-title">Dashboard Overview</div>
    <div class="dash-page-subtitle">Welcome back — here's what's happening today</div>
  </div>
  <div class="dash-header-btns">
    <a href="/admin/properties/add" class="dash-btn dash-btn-primary">+ Add Property</a>
    <a href="/admin/reports" class="dash-btn dash-btn-outline">View Reports</a>
  </div>
</div>

<!-- STATS GRID -->
<div class="dash-stats">
  <div class="dash-stat">
    <div class="dash-stat-bar" style="background:linear-gradient(90deg,#083068,#2171B5);"></div>
    <div class="dash-stat-label">Total Properties</div>
    <div class="dash-stat-val"><%= (stats.totalProperties || 0).toLocaleString() %></div>
    <div class="dash-stat-sub">All listings</div>
  </div>
  <div class="dash-stat">
    <div class="dash-stat-bar" style="background:linear-gradient(90deg,#08519C,#6BAED6);"></div>
    <div class="dash-stat-label">Active Listings</div>
    <div class="dash-stat-val"><%= (stats.activeListings || 0).toLocaleString() %></div>
    <div class="dash-stat-sub">Live now</div>
  </div>
  <div class="dash-stat">
    <div class="dash-stat-bar" style="background:linear-gradient(90deg,#2171B5,#C6DBEF);"></div>
    <div class="dash-stat-label">Total Users</div>
    <div class="dash-stat-val"><%= (stats.totalUsers || 0).toLocaleString() %></div>
    <div class="dash-stat-sub">Registered</div>
  </div>
  <div class="dash-stat">
    <div class="dash-stat-bar" style="background:linear-gradient(90deg,#6BAED6,#DEEBF7);"></div>
    <div class="dash-stat-label">Inquiries</div>
    <div class="dash-stat-val"><%= (stats.inquiries || 0).toLocaleString() %></div>
    <div class="dash-stat-sub">Total received</div>
  </div>
</div>

<!-- RECENT -->
<div class="dash-two-col">
  <div class="dash-card">
    <div class="dash-card-header">
      <div class="dash-card-title">Recent Properties</div>
      <a href="/admin/properties" class="dash-btn dash-btn-outline" style="padding:6px 14px;font-size:12px;">View All</a>
    </div>
    <% if(!recentProperties || recentProperties.length === 0) { %>
      <div class="dash-empty">No properties yet.</div>
    <% } else { %>
      <% recentProperties.forEach(function(p) { %>
        <div class="dash-prop-row">
          <div class="dash-prop-icon"><%= p.icon %></div>
          <div style="flex:1;min-width:0;">
            <div class="dash-prop-name"><%= p.title %></div>
            <div class="dash-prop-meta"><%= p.location %> &nbsp;·&nbsp; <%= p.listingType %></div>
          </div>
          <div class="dash-prop-price"><%= p.price %></div>
        </div>
      <% }) %>
    <% } %>
  </div>

  <div class="dash-card">
    <div class="dash-card-header">
      <div class="dash-card-title">Recent Inquiries</div>
      <a href="/admin/inquiries" class="dash-btn dash-btn-outline" style="padding:6px 14px;font-size:12px;">View All</a>
    </div>
    <% if(!recentInquiries || recentInquiries.length === 0) { %>
      <div class="dash-empty">No inquiries yet.</div>
    <% } else { %>
      <% recentInquiries.forEach(function(inq) { %>
        <div class="dash-inq-row">
          <div class="dash-avatar"><%= inq.initials %></div>
          <div style="flex:1;min-width:0;">
            <div class="dash-inq-name"><%= inq.name %></div>
            <div class="dash-inq-msg"><%= inq.message %></div>
          </div>
          <div class="dash-inq-time"><%= inq.time %></div>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>

<!-- CHARTS -->
<div class="dash-two-col">
  <div class="dash-card">
    <div class="dash-card-header"><div class="dash-card-title">Listings by District</div></div>
    <% var distColors = ['#083068','#08519C','#2171B5','#6BAED6','#C6DBEF']; %>
    <% if(!byDistrict || byDistrict.length === 0) { %>
      <div class="dash-empty">No data yet.</div>
    <% } else { %>
      <% byDistrict.forEach(function(d, i) { %>
        <div class="dash-bar-row">
          <div class="dash-bar-label"><%= d.name %></div>
          <div class="dash-bar-track">
            <div class="dash-bar-fill" style="width:<%= d.pct %>%;background:<%= distColors[i] || '#2171B5' %>;"></div>
          </div>
          <div class="dash-bar-count"><%= d.count %></div>
        </div>
      <% }) %>
    <% } %>
  </div>

  <div class="dash-card">
    <div class="dash-card-header"><div class="dash-card-title">Listings by Type</div></div>
    <% var typeColors = ['#083068','#08519C','#2171B5','#6BAED6','#C6DBEF']; %>
    <% if(!byType || byType.length === 0) { %>
      <div class="dash-empty">No data yet.</div>
    <% } else { %>
      <% byType.forEach(function(t, i) { %>
        <div class="dash-bar-row">
          <div class="dash-bar-label"><%= t.name %></div>
          <div class="dash-bar-track">
            <div class="dash-bar-fill" style="width:<%= t.pct %>%;background:<%= typeColors[i] || '#2171B5' %>;"></div>
          </div>
          <div class="dash-bar-count"><%= t.count %></div>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>
