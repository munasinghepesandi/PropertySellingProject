<%
  title = title || "Inquiries";
  page  = page  || "inquiries";
%>

<style>
  .inq-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;}
  .inq-title{font-size:22px;font-weight:700;color:#083068;}
  .inq-filter-card{background:#fff;border:1px solid #DEEBF7;border-radius:14px;padding:14px 20px;margin-bottom:16px;display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;}
  .inq-fg{display:flex;flex-direction:column;gap:5px;}
  .inq-fg label{font-size:11px;font-weight:700;letter-spacing:.7px;text-transform:uppercase;color:#4a6380;}
  .inq-sel{padding:8px 12px;border:1.5px solid #DEEBF7;border-radius:8px;font-size:13px;color:#083068;background:#F0F6FF;outline:none;font-family:inherit;cursor:pointer;}
  .inq-sel:focus{border-color:#6BAED6;background:#fff;}
  .ibtn{padding:8px 18px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;border:none;font-family:inherit;display:inline-flex;align-items:center;gap:5px;text-decoration:none;}
  .ibtn-primary{background:#083068;color:#fff;} .ibtn-primary:hover{background:#08519C;}
  .ibtn-outline{background:#fff;color:#083068;border:1.5px solid #DEEBF7;} .ibtn-outline:hover{background:#F0F6FF;}
  .ibtn-sm{padding:5px 12px;font-size:12px;}
  .ibtn-resolve{background:#D1FAE5;color:#065F46;border:1.5px solid #6EE7B7;} .ibtn-resolve:hover{background:#A7F3D0;}
  .ibtn-del{background:#FEE2E2;color:#DC2626;border:1.5px solid #FCA5A5;} .ibtn-del:hover{background:#FCA5A5;}
  .inq-card{background:#fff;border:1px solid #DEEBF7;border-radius:14px;overflow:hidden;}
  .inq-tbl{width:100%;border-collapse:collapse;}
  .inq-tbl thead tr{background:#F0F6FF;border-bottom:2px solid #DEEBF7;}
  .inq-tbl th{padding:12px 14px;text-align:left;font-size:11px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:#4a6380;}
  .inq-tbl tbody tr{border-bottom:1px solid #F0F6FF;transition:background .12s;}
  .inq-tbl tbody tr:last-child{border-bottom:none;}
  .inq-tbl tbody tr:hover{background:#F8FBFF;}
  .inq-tbl td{padding:11px 14px;font-size:13px;color:#083068;vertical-align:middle;}
  .inum{color:#6BAED6;font-weight:600;font-size:12px;}
  .iav{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#2171B5,#6BAED6);color:#fff;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .itag{display:inline-block;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;}
  .itag-new{background:#DBEAFE;color:#1D4ED8;}
  .itag-read{background:#FEF3C7;color:#92400E;}
  .itag-replied{background:#D1FAE5;color:#065F46;}
  .inq-empty{text-align:center;padding:48px 20px;color:#6BAED6;font-size:14px;}
  .inq-pgn{display:flex;gap:6px;justify-content:center;padding:16px 0 4px;}
  .inq-pgbtn{width:34px;height:34px;border-radius:8px;border:1.5px solid #DEEBF7;background:#fff;color:#083068;font-size:13px;font-weight:600;cursor:pointer;transition:all .15s;}
  .inq-pgbtn:hover{background:#F0F6FF;}
  .inq-pgbtn.active{background:#083068;color:#fff;border-color:#083068;}
</style>

<div class="inq-header">
  <div class="inq-title">Inquiries</div>
</div>

<div class="inq-filter-card">
  <div class="inq-fg">
    <label>Status</label>
    <select class="inq-sel" onchange="window.location='?status='+this.value" style="width:150px;">
      <option value="">All Status</option>
      <option value="new"     <%= filters.status==='new'     ? 'selected':'' %>>New</option>
      <option value="read"    <%= filters.status==='read'    ? 'selected':'' %>>Read</option>
      <option value="replied" <%= filters.status==='replied' ? 'selected':'' %>>Replied</option>
    </select>
  </div>
</div>

<div class="inq-card">
  <table class="inq-tbl">
    <thead>
      <tr>
        <th>No</th><th>User</th><th>Property</th><th>Message</th>
        <th>Phone</th><th>Status</th><th>Date</th><th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if(!inquiries || inquiries.length === 0) { %>
        <tr>
          <td colspan="8">
            <div class="inq-empty">
              <div style="font-size:36px;margin-bottom:8px;">📩</div>
              <div>No inquiries found.</div>
            </div>
          </td>
        </tr>
      <% } else { %>
        <% inquiries.forEach(function(inq, i) { %>
        <tr>
          <td class="inum"><%= (currentPage-1)*perPage + i+1 %></td>
          <td>
            <div style="display:flex;align-items:center;gap:9px;">
              <div class="iav"><%= inq.initials %></div>
              <div>
                <div style="font-weight:600;color:#083068;font-size:13px;"><%= inq.name %></div>
                <div style="font-size:11px;color:#6BAED6;"><%= inq.email || '—' %></div>
              </div>
            </div>
          </td>
          <td style="max-width:160px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:12px;color:#2171B5;"><%= inq.propertyTitle %></td>
          <td style="max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:12.5px;"><%= inq.message %></td>
          <td style="font-size:12px;color:#4a6380;"><%= inq.phone || '—' %></td>
          <td>
            <span class="itag <%= inq.status==='new' ? 'itag-new' : inq.status==='read' ? 'itag-read' : 'itag-replied' %>">
              <%= inq.status==='new' ? 'New' : inq.status==='read' ? 'Read' : 'Replied' %>
            </span>
          </td>
          <td style="font-size:11.5px;color:#6BAED6;"><%= inq.createdAt %></td>
          <td>
            <div style="display:flex;gap:6px;">
              <% if(inq.status !== 'replied') { %>
                <form method="POST" action="/admin/inquiries/<%= inq.id %>/resolve" style="display:inline;">
                  <button class="ibtn ibtn-resolve ibtn-sm" type="submit">✔ Resolve</button>
                </form>
              <% } %>
              <form method="POST" action="/admin/inquiries/<%= inq.id %>/delete" style="display:inline;" onsubmit="return confirm('Delete?')">
                <button class="ibtn ibtn-del ibtn-sm" type="submit">🗑️</button>
              </form>
            </div>
          </td>
        </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>

  <% if(totalPages > 1) { %>
    <div class="inq-pgn">
      <% for(var i = 1; i <= totalPages; i++) { %>
        <a href="?page=<%= i %>&status=<%= filters.status||'' %>">
          <button class="inq-pgbtn <%= i===currentPage ? 'active' : '' %>"><%= i %></button>
        </a>
      <% } %>
    </div>
  <% } %>
</div>
